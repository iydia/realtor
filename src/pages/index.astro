---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactRow from '../components/ContactRow.astro';
import { config } from '../config.mjs';

const telHref = (value?: string) => (value ? `tel:${value.replace(/[^+\d]/g, '')}` : undefined);
const mapHref = (value?: string) =>
  value ? `https://maps.google.com/?q=${encodeURIComponent(value)}` : undefined;

const pageTitle = `${config.firstName} ${config.lastName} — ${config.officeName}`;
---

<BaseLayout title={pageTitle}>
  <div class="page-bg">
    <main class="card">
      <div class="accent-bar">
        <div class="accent-bar-primary"></div>
        <div class="accent-bar-secondary"></div>
      </div>

      <div class="card-body">
        {
          config.officeLogoSrc && (
            <img class="brand-logo" src={config.officeLogoSrc} alt={config.officeName} />
          )
        }

        <div class="identity-row">
          {
            config.headshotSrc && (
              <img
                class="headshot"
                src={config.headshotSrc}
                alt={`${config.firstName} ${config.lastName}`}
              />
            )
          }
          <div class="identity">
            <div class="identity-names">
              <h1 class="identity-name">{config.firstName} {config.lastName}</h1>
              {config.altName && <p class="identity-alt" lang="zh-Hans">{config.altName}</p>}
            </div>
            <p class="identity-title">Real Estate Broker · REALTOR&reg;</p>
          </div>
        </div>

        <ul class="contact-list">
          <ContactRow value={config.phone} href={telHref(config.phone)}>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path>
            </svg>
          </ContactRow>
          <ContactRow value={config.email} href={config.email ? `mailto:${config.email}` : undefined}>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <path d="m22 7-10 6L2 7"></path>
            </svg>
          </ContactRow>
          <ContactRow value={config.cityProvinceCountry}>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </ContactRow>
        </ul>

        {
          config.officeName && (
            <section class="office-section">
              <h2 class="office-heading">Office</h2>
              {config.officeWebsite ? (
                <a class="office-link" href={config.officeWebsite}>
                  {config.officeName}
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M7 17 17 7M8 7h9v9"></path>
                  </svg>
                </a>
              ) : (
                <span class="office-link">{config.officeName}</span>
              )}
              
              {config.officePhone && <a href={telHref(config.officePhone)}>{config.officePhone}</a>}
            </section>
          )
        }
      </div>

      {
        (config.industryLicenseText || config.industrySinceYear || config.industryAwardsText || config.industryAwardsTextAlt) && (
          <div class="footer-bar">
            {config.industryLicenseText && <span>{config.industryLicenseText}</span>}
            {config.industrySinceYear && (
              <span>Serving {config.cityProvinceCountry} since {config.industrySinceYear}</span>
            )}
            {(config.industryAwardsText || config.industryAwardsTextAlt) && (
              <div class="industry-awards">
                {config.industryAwardsText && <span>{config.industryAwardsText}</span>}
                {config.industryAwardsTextAlt && (
                  <span class="industry-awards-alt" lang="zh-Hans">{config.industryAwardsTextAlt}</span>
                )}
              </div>
            )}
          </div>
        )
      }
    </main>
  </div>
</BaseLayout>
